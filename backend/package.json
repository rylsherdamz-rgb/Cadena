{
  "name": "backend",
  "version": "1.0.0",
  "description": "Cadena Election Contract Backend",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:tenderly": "hardhat run scripts/deploy.ts --network tenderly",
    "deploy:all": "npm run deploy:election && npm run deploy:rps && npm run deploy:messaging && npm run deploy:budget",
    "deploy:all:tenderly": "npm run deploy:election:tenderly && npm run deploy:rps:tenderly && npm run deploy:messaging:tenderly && npm run deploy:budget:tenderly",
    "deploy:election": "hardhat ignition deploy ignition/modules/Election.ts --network sepolia",
    "deploy:rps": "hardhat ignition deploy ignition/modules/RockPaperScissors.ts --network sepolia",
    "deploy:messaging": "hardhat ignition deploy ignition/modules/DecentralizedMessaging.ts --network sepolia",
    "deploy:budget": "hardhat ignition deploy ignition/modules/NationalBudget.ts --network sepolia",
    "deploy:election:tenderly": "hardhat ignition deploy ignition/modules/Election.ts --network tenderly",
    "deploy:rps:tenderly": "hardhat ignition deploy ignition/modules/RockPaperScissors.ts --network tenderly",
    "deploy:messaging:tenderly": "hardhat ignition deploy ignition/modules/DecentralizedMessaging.ts --network tenderly",
    "deploy:budget:tenderly": "hardhat ignition deploy ignition/modules/NationalBudget.ts --network tenderly",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "flatten": "hardhat flatten"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.5",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^4.1.2",
    "@tenderly/hardhat-tenderly": "^2.5.2",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.2.3"
  }
}
